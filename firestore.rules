rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'yangzhou833@gmail.com'; }

    // Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName']) && data.keys().hasOnly(['uid', 'email', 'displayName']) &&
             data.uid is string && data.email is string && data.displayName is string;
    }
    function isValidAnnotation(data) {
      return data.keys().hasAll(['annotationId', 'bookId', 'userId', 'text', 'page']) && data.keys().hasOnly(['annotationId', 'bookId', 'userId', 'text', 'page']) &&
             data.annotationId is string && data.bookId is string && data.userId is string && data.text is string && data.text.size() <= 1000 && data.page is number && data.page >= 0;
    }
    // ... other validators ...

    // Global deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Match Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isValidUser(incoming());
    }

    match /books/{bookId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId}/library/{bookId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    match /books/{bookId}/annotations/{annotationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAnnotation(incoming());
      allow update: if isOwner(resource.data.userId) && isValidAnnotation(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'page']);
      allow delete: if isOwner(resource.data.userId);
    }
    
    match /userBooks/{docId} {
      allow read: if isSignedIn();
    }
    
    match /mapHotspots/{hotspotId} {
      allow read: if isSignedIn();
    }
    
    // ... other collections ...
  }
}
