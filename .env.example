# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Map & External Service Provider API Configurations
VITE_GOOGLE_MAPS_API_KEY=
VITE_WEATHER_API_URL=
VITE_NOTIFICATION_API_URL=
VITE_EMERGENCY_API_URL=
GOOGLE_MAPS_PLATFORM_KEY=

# Optional flight-data proxy; credentials stay on your backend.
VITE_FLIGHT_API_URL=

# Optional map tile provider override（上线前换掉 OSM 公共瓦片时用，只改这里，不用动代码）。
# 留空 = 继续用 tile.openstreetmap.org（仅适合开发/演示：其 Tile Usage Policy 禁止重度使用）。
# 换成自托管瓦片或 OpenFreeMap 时，务必同时填上对应署名，否则违反数据许可。
VITE_TILE_URL_OVERRIDE=
VITE_TILE_ATTRIBUTION=
